# Copy to .env and fill in. Never commit .env.
# The engine has its own keys; see engine/.env.example.

# Required by the orchestrator (agents/orchestrator/agent.py)
# AGENT_SEED decides the agent's address. The registered Standby agent is
# agent1qwyumnrwayag0jyfy28ajzwwdn5rxz4awr4ft5rltr86zs36444z5f6mmzf — a different
# seed comes up as a different address and loses its mailbox, profile and badges.
AGENT_SEED=
ANTHROPIC_API_KEY=
ENGINE_URL=http://localhost:8000

# Required by the caller agent (agents/caller/agent.py). Not fetched from anywhere:
# generate any high-entropy string. No existing identity to preserve.
CALLER_SEED=

# Optional. Defaults to claude-sonnet-5; use claude-haiku-4-5 if latency is bad.
CLAUDE_MODEL=

# Optional, read by nothing today. Keep the names so nobody has to rediscover them:
# AGENTVERSE_API_KEY — only to drive Agentverse over its API (hosting agents there,
#   editing a profile from a script). agentverse.ai/profile/api-keys. The mailbox does
#   not need it: a mailbox agent authenticates with its own identity.
# ASI_ONE_API_KEY — only to call ASI:One models from code. We reason with Claude, so
#   it is unused. asi1.ai, under Developer / API Keys.
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=
