[Unit]
Description=Standby Caller agent (Fetch.ai uAgent, paid per call over the Payment Protocol)
After=network-online.target handle-it.service
Wants=network-online.target

[Service]
User=handleit
WorkingDirectory=/opt/handle-it/agents
# Keys and seeds: CALLER_SEED. Either file may hold them; later files win.
EnvironmentFile=-/opt/handle-it/engine/.env
EnvironmentFile=-/opt/handle-it/.env
Environment=ENGINE_URL=http://127.0.0.1:8000
Environment=PYTHONUNBUFFERED=1
# Exactly one copy of this agent may run: it owns the agent's Agentverse mailbox.
ExecStart=/opt/handle-it/agents/.venv/bin/python caller/agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
