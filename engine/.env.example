# Copy to .env and fill in. Never commit .env.

# mock = simulated clerk call; elevenlabs = real outbound call
CALL_MODE=mock

# ElevenLabs + Twilio (only for CALL_MODE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# The phone on the demo table (E.164, e.g. +13105550123)
CALL_TO_NUMBER=
# Post-call webhook secret from ElevenLabs (webhook URL: https://<engine>/call/webhook)
ELEVENLABS_WEBHOOK_SECRET=

# Claude: checks the call outcome against the transcript (app/verify.py)
ANTHROPIC_API_KEY=

# Voice commands from the glasses (app/voice.py), through OpenRouter: speech-to-text + intent
OPENROUTER_API_KEY=
# Optional overrides (defaults are tuned for speed)
VOICE_STT_MODEL=openai/whisper-large-v3-turbo
# Primary: a decision model (Decisions API). Fallback: a chat model, used only if the primary fails or isn't sure
VOICE_INTENT_MODEL=typesafe/jev-1.14
VOICE_FALLBACK_MODEL=anthropic/claude-haiku-4.5
# Signed payment requests (TAP-style). Public URL of this engine, for the key directory link.
PUBLIC_URL=http://localhost:8000
# Optional: base64 raw 32-byte Ed25519 key so the key id survives restarts. Generate with:
# python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
TAP_PRIVATE_KEY=

# Flights: mock = fares from contract/mock-data.json; duffel = live fares + real test-mode orders
FLIGHTS_MODE=mock
# Duffel access token (use the test one: duffel_test_...). Any Duffel error falls back to mock fares.
DUFFEL_TOKEN=

# Agent: claude = Claude checks the flight, searches, chooses and decides whether to call (needs ANTHROPIC_API_KEY);
# off = the scripted flow. Any Claude error falls back to the scripted flow.
AGENT_MODE=off

# Live flight status for any flight number (POST /ask, the agent's check_flight_status): FlightAware AeroAPI key.
# The trip's own (demo) flights always answer from the trip.
AEROAPI_KEY=
# Free mode (before Start): auto = the traveler's flight is the next real LAX->SFO nonstop (United first);
# a flight number pins one (it should fly LAX->SFO); off = the mock UA183. Needs AEROAPI_KEY.
LIVE_FLIGHT=auto
# Free questions (POST /ask, push-to-talk on the glasses): a fast model; needs ANTHROPIC_API_KEY only.
ASK_MODEL=claude-haiku-4-5

# Voice: picking a flight on the list by name ("the Alaska one") uses Ollama.
# Local Ollama on the engine's machine: leave OLLAMA_URL as is and `ollama pull <model>`.
# Ollama Cloud: OLLAMA_URL=https://ollama.com, OLLAMA_API_KEY from ollama.com/settings/keys, a cloud model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=
