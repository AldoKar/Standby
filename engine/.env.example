# Copy to .env and fill in. Never commit .env.

# mock = simulated clerk call; elevenlabs = real outbound call
CALL_MODE=mock

# ElevenLabs + Twilio (only for CALL_MODE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# The phone on the demo table (E.164, e.g. +13105550123)
CALL_TO_NUMBER=
# Post-call webhook secret from ElevenLabs (webhook URL: https://<engine>/call/webhook)
ELEVENLABS_WEBHOOK_SECRET=

# Claude: checks the call outcome against the transcript (app/verify.py)
ANTHROPIC_API_KEY=

# Signed payment requests (TAP-style). Public URL of this engine, for the key directory link.
PUBLIC_URL=http://localhost:8000
# Optional: base64 raw 32-byte Ed25519 key so the key id survives restarts. Generate with:
# python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
TAP_PRIVATE_KEY=
