# Copy to .env and fill in. Never commit .env.

# mock = simulated clerk call; elevenlabs = real outbound call
CALL_MODE=mock

# ElevenLabs + Twilio (only for CALL_MODE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# The phone on the demo table (E.164, e.g. +13105550123)
CALL_TO_NUMBER=
# Post-call webhook secret from ElevenLabs (webhook URL: https://<engine>/call/webhook)
ELEVENLABS_WEBHOOK_SECRET=

# Claude: checks the call outcome against the transcript (app/verify.py)
ANTHROPIC_API_KEY=

# Voice commands from the glasses (app/voice.py), through OpenRouter: speech-to-text + intent
OPENROUTER_API_KEY=
# Optional overrides (defaults are tuned for speed)
VOICE_STT_MODEL=openai/whisper-large-v3-turbo
# Primary: a decision model (Decisions API). Fallback: a chat model, used only if the primary fails or isn't sure
VOICE_INTENT_MODEL=typesafe/jev-1.14
VOICE_FALLBACK_MODEL=anthropic/claude-haiku-4.5
