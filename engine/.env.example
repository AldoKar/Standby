# Copy to .env and fill in. Never commit .env.

# mock = simulated clerk call; elevenlabs = real outbound call
CALL_MODE=mock

# ElevenLabs + Twilio (only for CALL_MODE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# The phone on the demo table (E.164, e.g. +13105550123)
CALL_TO_NUMBER=
# Post-call webhook secret from ElevenLabs (webhook URL: https://<engine>/call/webhook)
ELEVENLABS_WEBHOOK_SECRET=

# Gemini: checks the call outcome against the transcript (app/verify.py)
GEMINI_API_KEY=
# Optional; models tried in order when one is overloaded
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-flash-latest
