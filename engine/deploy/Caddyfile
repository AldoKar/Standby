# Replace DOMAIN with your domain, e.g. 203.0.113.10.sslip.io (see DEPLOY.md).
# Caddy gets and renews the Let's Encrypt certificate on its own.
DOMAIN {
	reverse_proxy 127.0.0.1:8000 {
		# Push SSE events (GET /events) to clients immediately, no buffering.
		flush_interval -1
	}
}

# The glasses app's web page (g2-app/dist): the "Link glasses" QR on it points here, so the Even app can open
# Standby from anywhere. glasses.DOMAIN resolves like DOMAIN (sslip.io takes any prefix). See DEPLOY.md, step 8.
glasses.DOMAIN {
	root * /opt/handle-it/g2-app/dist
	try_files {path} /index.html
	file_server
}
